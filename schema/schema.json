{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "BoolOrString": {
            "description": "BoolOrString can be a bool or string \"true\"/\"false\"",
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "const": "true"
                },
                {
                    "const": "false"
                }
            ]
        },
        "ImageSpec": {
            "type": "object",
            "description": "ImageSpec defines an image configuration",
            "additionalProperties": false,
            "properties": {
                "ami": {
                    "type": "string",
                    "description": "AMI ID"
                },
                "arch": {
                    "type": "string",
                    "description": "Architecture (e.g., \"x64\", \"arm64\")"
                },
                "id": {
                    "type": "string",
                    "description": "Optional unique identifier"
                },
                "main_disk_size": {
                    "description": "Main disk size in GB",
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                },
                "name": {
                    "type": "string",
                    "description": "Image name"
                },
                "owner": {
                    "type": "string",
                    "description": "Image owner"
                },
                "platform": {
                    "type": "string",
                    "description": "Platform (e.g., \"linux\", \"windows\")"
                },
                "preinstall": {
                    "type": "string",
                    "description": "Preinstall script"
                },
                "prerun": {
                    "type": "string",
                    "description": "Prerun script"
                },
                "root_device_name": {
                    "type": "string",
                    "description": "Root device name"
                },
                "tags": {
                    "type": "object",
                    "description": "Tags for the image",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        },
        "IntArray": {
            "description": "IntArray can be a single int/float, string representation, or array\nString values can use \"+\" separator (e.g., \"2+4\" is equivalent to [2, 4])\nFloat values are allowed (e.g., 0.5 for half a CPU core)",
            "anyOf": [
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        },
        "PoolSchedule": {
            "type": "object",
            "description": "PoolSchedule defines a schedule entry for a pool",
            "additionalProperties": false,
            "properties": {
                "hot": {
                    "description": "Number of hot instances",
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                },
                "match": {
                    "description": "Optional match criteria",
                    "$ref": "#/$defs/ScheduleMatch"
                },
                "name": {
                    "type": "string",
                    "description": "Schedule name (required, cannot be empty)",
                    "not": {
                        "const": ""
                    }
                },
                "stopped": {
                    "description": "Number of stopped instances",
                    "allOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                }
            },
            "required": [
                "hot",
                "name",
                "stopped"
            ]
        },
        "PoolSpec": {
            "type": "object",
            "description": "PoolSpec defines a pool configuration",
            "additionalProperties": false,
            "properties": {
                "env": {
                    "type": "string",
                    "description": "Environment name (defaults to \"production\" if not set)"
                },
                "environment": {
                    "type": "string",
                    "description": "Environment name (DEPRECATED: use env instead)"
                },
                "runner": {
                    "type": "string",
                    "description": "Runner reference (required)",
                    "not": {
                        "const": ""
                    }
                },
                "schedule": {
                    "type": "array",
                    "description": "Schedule configuration",
                    "items": {
                        "$ref": "#/$defs/PoolSchedule"
                    }
                },
                "timezone": {
                    "type": "string",
                    "description": "Timezone (defaults to \"UTC\" if not set)"
                },
                "version": {
                    "type": "string",
                    "description": "Pool version"
                }
            },
            "required": [
                "runner"
            ]
        },
        "RunnerSpec": {
            "type": "object",
            "description": "RunnerSpec defines a runner configuration",
            "additionalProperties": false,
            "properties": {
                "cpu": {
                    "description": "CPU count(s) - can be single int/float, string (e.g., \"2+4\"), or array",
                    "$ref": "#/$defs/IntArray"
                },
                "debug": {
                    "description": "Debug mode (bool or string \"true\"/\"false\")",
                    "$ref": "#/$defs/BoolOrString"
                },
                "disk": {
                    "type": "string",
                    "description": "Disk size (DEPRECATED and ignored: use volume instead)"
                },
                "extras": {
                    "description": "Extra features (e.g., \"s3-cache\", \"efs\") - can be string (e.g., \"s3-cache+tmpfs\") or array",
                    "$ref": "#/$defs/StringArray"
                },
                "family": {
                    "description": "Instance family - can be string (e.g., \"c7a+m7a\") or array (e.g., [\"c7a\", \"m7a\"])",
                    "$ref": "#/$defs/StringArray"
                },
                "id": {
                    "type": "string",
                    "description": "Optional unique identifier for the runner"
                },
                "image": {
                    "type": "string",
                    "description": "Image reference"
                },
                "nested-virt": {
                    "description": "Nested virtualization configuration (bool or string \"true\"/\"false\")",
                    "$ref": "#/$defs/BoolOrString"
                },
                "preinstall": {
                    "type": "string",
                    "description": "Preinstall script"
                },
                "prerun": {
                    "type": "string",
                    "description": "Prerun script"
                },
                "private": {
                    "description": "Private network configuration (bool or string \"true\"/\"false\")",
                    "$ref": "#/$defs/BoolOrString"
                },
                "ram": {
                    "description": "RAM in GB - can be single int, string (e.g., \"16+32\"), or array",
                    "$ref": "#/$defs/IntArray"
                },
                "retry": {
                    "description": "Retry configuration - can be string (e.g., \"always+on-failure\") or array",
                    "anyOf": [
                        {
                            "$ref": "#/$defs/StringArray"
                        },
                        {
                            "type": "boolean"
                        }
                    ]
                },
                "spot": {
                    "description": "Spot instance configuration\nValues: \"false\", \"never\", \"true\", \"pco\", \"price-capacity-optimized\",\n        \"lp\", \"lowest-price\", \"co\", \"capacity-optimized\"",
                    "$ref": "#/$defs/SpotValue"
                },
                "ssh": {
                    "description": "SSH access configuration (bool or string \"true\"/\"false\")",
                    "$ref": "#/$defs/BoolOrString"
                },
                "sticky": {
                    "type": "string",
                    "description": "Sticky disk specification: optional lineage name, size, and volume settings\ne.g., \"20gb\" or \"go-cache:20gb:gp3:750mibps:6000iops:lazy-init\""
                },
                "tags": {
                    "description": "Tags for the runner",
                    "$ref": "#/$defs/StringArray"
                },
                "volume": {
                    "type": "string",
                    "description": "Volume specification: format: size:type:throughput:iops\ne.g., \"80gb:gp3:125mibps:3000iops\""
                }
            }
        },
        "ScheduleMatch": {
            "type": "object",
            "description": "ScheduleMatch defines time-based matching criteria",
            "additionalProperties": false,
            "properties": {
                "day": {
                    "type": "array",
                    "description": "Days of the week (e.g., [\"monday\", \"tuesday\"])",
                    "items": {
                        "type": "string"
                    }
                },
                "time": {
                    "type": "array",
                    "description": "Time ranges (e.g., [\"22:00\", \"06:00\"])",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "SpotValue": {
            "description": "SpotValue defines valid spot instance configuration values\nNote: Boolean values (false/true) are automatically normalized to strings (\"false\"/\"true\") during validation",
            "enum": [
                "false",
                "never",
                "true",
                "pco",
                "price-capacity-optimized",
                "lp",
                "lowest-price",
                "co",
                "capacity-optimized"
            ]
        },
        "StringArray": {
            "description": "StringArray can be a single string or array of strings\nString values can use \"+\" separator (e.g., \"s3-cache+tmpfs\" is equivalent to [\"s3-cache\", \"tmpfs\"])",
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            ]
        }
    },
    "type": "object",
    "description": "RepoConfig defines the structure of a runs-on.yml configuration file",
    "additionalProperties": true,
    "properties": {
        "admins": {
            "type": "array",
            "description": "List of admin usernames",
            "items": {
                "type": "string"
            }
        },
        "images": {
            "type": "object",
            "description": "Map of image specifications",
            "additionalProperties": {
                "$ref": "#/$defs/ImageSpec"
            }
        },
        "pools": {
            "type": "object",
            "description": "Map of pool specifications",
            "additionalProperties": false,
            "patternProperties": {
                "^[a-z0-9_-]+$": {
                    "$ref": "#/$defs/PoolSpec"
                }
            }
        },
        "runners": {
            "type": "object",
            "description": "Map of runner specifications",
            "additionalProperties": {
                "$ref": "#/$defs/RunnerSpec"
            }
        }
    }
}
